# Copia este archivo como .env y pon tu clave (https://console.anthropic.com/).
# Solo se necesita para reconocer fotos; la entrada de texto funciona sin ella.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: contraseña para entrar a la app. Recomendada si la abres desde el celular
# o desde otros equipos de la red.
# STATSOLVER_PASSWORD=elige-una-clave
